rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'hamzaiqbal333@gmail.com';
    }

    function isAdmin() {
      return isSignedIn();
    }

    function isValidInquiryCreate(data) {
      return data.keys().hasAll(['name', 'studio', 'email', 'service', 'message', 'status', 'createdAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.studio is string && data.studio.size() >= 1 && data.studio.size() <= 120 &&
        data.email is string && data.email.size() <= 120 && data.email.matches('^.+@.+\\..+$') &&
        data.service is string && data.service.size() <= 100 &&
        data.message is string && data.message.size() <= 3000 &&
        data.status == 'new';
    }

    match /inquiries/{inquiryId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(inquiryId);
      allow update: if isAdmin() && isValidId(inquiryId);
      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    match /content/{contentId} {
      allow read: if isValidId(contentId);
      allow write: if isAdmin() && isValidId(contentId);
    }

    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
